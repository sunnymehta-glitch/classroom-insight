# Classroom Insight — Environment Configuration Template
# Copy this file to .env for local overrides. Never commit .env with secrets.

# ==============================================================================
# Spring Boot Public Backend Configuration
# ==============================================================================
SERVER_PORT=8080

# URL of the internal Python FastAPI ML inference service
# For local development: http://localhost:8000
# For Docker Compose: http://ml-service:8000
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# File-backed H2 Database Configuration
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/h2/classroom_insight;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_H2_CONSOLE_ENABLED=true

# ==============================================================================
# FastAPI ML Inference Service Configuration
# ==============================================================================
ML_HOST=0.0.0.0
ML_PORT=8000
ARTIFACTS_DIR=./ml-service/artifacts
REPORTS_DIR=./docs/reports

# ==============================================================================
# React Frontend Configuration (Vite)
# ==============================================================================
# Public API base URL pointing to the Spring Boot backend
VITE_API_BASE_URL=http://localhost:8080/api

# ==============================================================================
# Production Cloud Deployment Template (Vercel + Render + Neon)
# See docs/DEPLOYMENT_GUIDE.md for complete setup instructions.
# ==============================================================================
# Render Web Service Environment Variables:
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-hostname>/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-username>
# SPRING_DATASOURCE_PASSWORD=<neon-password>
# CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app
# JAVA_OPTS=-Xms64m -Xmx192m -XX:+UseSerialGC -XX:MaxMetaspaceSize=112m -XX:ReservedCodeCacheSize=48m -Xss512k -XX:+ExitOnOutOfMemoryError
#
# Vercel Project Environment Variables:
# VITE_API_BASE_URL=https://<your-render-service>.onrender.com/api

